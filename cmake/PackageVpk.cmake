set(STAGING "${PORT_BUILD}/vpk-stage")
file(MAKE_DIRECTORY "${STAGING}/sce_sys/livearea/contents")
configure_file("${PORT_BUILD}/eboot.bin" "${STAGING}/eboot.bin" COPYONLY)
configure_file("${PORT_BUILD}/Zombiewood.vpk_param.sfo" "${STAGING}/sce_sys/param.sfo" COPYONLY)
foreach(NAME cpuinfo meminfo urandom)
  configure_file("${PORT_SOURCE}/extras/${NAME}" "${STAGING}/${NAME}" COPYONLY)
endforeach()
foreach(NAME icon0.png pic0.png)
  configure_file("${PORT_SOURCE}/extras/livearea/${NAME}" "${STAGING}/sce_sys/${NAME}" COPYONLY)
endforeach()
foreach(NAME startup.png bg0.png template.xml)
  configure_file("${PORT_SOURCE}/extras/livearea/${NAME}" "${STAGING}/sce_sys/livearea/contents/${NAME}" COPYONLY)
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${PORT_BUILD}/Zombiewood.vpk" --format=zip
  eboot.bin sce_sys cpuinfo meminfo urandom WORKING_DIRECTORY "${STAGING}" RESULT_VARIABLE RESULT)
if(NOT RESULT EQUAL 0)
  message(FATAL_ERROR "VPK packaging failed: ${RESULT}")
endif()
